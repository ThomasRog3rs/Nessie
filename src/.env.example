# Clerk (use the pk_live_/sk_live_ keys from the Production instance in production)
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
NUXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NUXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database: local file in dev, Turso in production
NESSIE_DATABASE_URL=file:.data/nessie.sqlite
NESSIE_DATABASE_AUTH_TOKEN=

# Production only (set in Netlify; netlify.toml already sets these)
# NESSIE_STORAGE=netlify-blobs
# NESSIE_BACKUP_STORE=netlify-blobs
# NESSIE_SEED_ON_EMPTY=false
# NESSIE_BACKUP_KEEP_DAILY=14
# NESSIE_BACKUP_KEEP_WEEKLY=8
